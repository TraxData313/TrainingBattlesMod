<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE NAVAL SATELLITE — the one assembly in this mod allowed to carry War Sails types in its
       TYPE SURFACE (base classes, fields, signatures). It is loaded by hand (NavalBridge, in the
       module) and ONLY when NavalDLC is already in the AppDomain, so a player without War Sails
       never touches it. The main module assembly must stay loadable with the DLC absent — a
       NavalDLC base type there made every type scan (view creators, MCM, savegame) throw and the
       whole mod fail at startup: the v1.3.0-1.3.3 "dependency error", Nexus report 2026.07.28. -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>TrainingBattles.Naval</RootNamespace>
    <AssemblyName>TrainingBattles.Naval</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module owns the log and the shared plumbing; the arrow points ONE way (module never
         references the satellite), so no cycle and no load-time pull of naval types. Private=false:
         the module's own build already puts TrainingBattles.dll in the deployed bin. -->
    <ProjectReference Include="..\TrainingBattles.Module\TrainingBattles.Module.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.DotNet">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.DotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- War Sails: referenced at build, never shipped — the satellite exists precisely to hold
         these types away from the module assembly. -->
    <Reference Include="NavalDLC">
      <HintPath>$(NavalDlcBinFolder)\NavalDLC.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
